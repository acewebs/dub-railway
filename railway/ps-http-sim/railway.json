{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/ps-http-sim -listen-addr=0.0.0.0 -listen-port=3900 -mysql-addr=$MYSQLHOST -mysql-port=$MYSQLPORT -mysql-dbname=$MYSQLDATABASE",
    "preDeployCommand": "echo skipping proxy pre-deploy",
    "restartPolicyType": "ON_FAILURE"
  }
}
