# ============================================================================
# Dub on Railway - template variable reference (the "Dub" service)
#
# This is what to set for each variable in the Railway template composer.
# Values are written as you enter them in the composer's value field.
#   - references ${{...}} and secret() functions are typed literally
#   - "" means leave empty; the deployer fills it from their own account
# ============================================================================

# ----------------------------------------------------------------------------
# AUTO-WIRED REFERENCES - do not edit. Railway resolves these per deployment.
# ----------------------------------------------------------------------------
DATABASE_URL=${{MySQL.MYSQL_URL}}                 # private, used at runtime
DATABASE_URL_BUILD=${{MySQL.MYSQL_PUBLIC_URL}}    # public, used only during build
PLANETSCALE_DATABASE_URL=http://root:${{MySQL.MYSQLPASSWORD}}@${{PlanetScale Proxy.RAILWAY_PRIVATE_DOMAIN}}:3900/${{MySQL.MYSQLDATABASE}}
NEXT_PUBLIC_APP_DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}
NEXTAUTH_URL=https://${{NEXT_PUBLIC_APP_DOMAIN}}

# ----------------------------------------------------------------------------
# GENERATED SECRETS - Railway generates a fresh value on each deploy.
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET=${{ secret(32) }}
CRON_SECRET=${{ secret(32) }}
ENCRYPTION_KEY=${{ secret(32, "base64") }}        # must base64-decode to exactly 32 bytes (verify on a test deploy)

# ----------------------------------------------------------------------------
# BUILD-ONLY PLACEHOLDERS - keep these dummy values so the build passes.
# Import-time SDK clients (Stripe, Upstash Vector) throw if empty during build.
# Replace only if you want Dub's billing (Stripe) or AI (Vector) features.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_dummy_for_build_only
STRIPE_APP_SECRET_KEY=sk_test_dummy_for_build_only
STRIPE_APP_SECRET_KEY_TEST=sk_test_dummy_for_build_only
STRIPE_APP_SECRET_KEY_SANDBOX=sk_test_dummy_for_build_only
UPSTASH_VECTOR_REST_URL=https://dummy-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=dummy_build_only_token

# ----------------------------------------------------------------------------
# DEFAULTS - editable. Change only if your region/host differs.
# ----------------------------------------------------------------------------
TINYBIRD_API_URL=https://api.tinybird.co
QSTASH_URL=https://qstash.upstash.io

# ----------------------------------------------------------------------------
# YOU PROVIDE - fill from your own accounts (all have free tiers).
# ----------------------------------------------------------------------------

# Upstash Redis: console.upstash.com -> your database -> "REST API"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Upstash QStash: console.upstash.com -> QStash (QSTASH_URL default above)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Tinybird: tinybird.co -> workspace -> Tokens (admin token)
TINYBIRD_API_KEY=""

# Object storage: Cloudflare R2 or AWS S3 (or a MinIO service on Railway)
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""              # e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_BASE_URL=""              # public bucket URL, e.g. https://pub-xxxx.r2.dev
STORAGE_PUBLIC_BUCKET=""
STORAGE_PRIVATE_BUCKET=""

# Login: configure at least one method. OAuth needs no email service.
# The OAuth callback needs your deployed domain, so set these AFTER first deploy.
#   GitHub OAuth app callback: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional alternatives (add these variables instead of, or alongside, GitHub):
#   GOOGLE_CLIENT_ID=""         # + GOOGLE_CLIENT_SECRET=""  (OAuth, no email service)
#   RESEND_API_KEY=""           # magic-link email login (resend.com/api-keys)

# ----------------------------------------------------------------------------
# NOT NEEDED (removed): UNSUBSCRIBE_TOKEN_SECRET falls back to NEXTAUTH_SECRET.
# Vercel-only vars (VERCEL_*, TEAM_ID_VERCEL) do not apply on Railway.
# ----------------------------------------------------------------------------
