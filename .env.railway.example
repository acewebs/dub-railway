# ============================================================================
# Dub on Railway - template variable reference (the "Dub" service)
#
# Paste-ready for the template composer's raw editor. Descriptions are INLINE
# trailing comments: the raw editor reads a variable's description from the
# comment on its own line, and otherwise from the comment on the line BELOW it,
# which is how an earlier version of this file gave 20 variables the wrong
# description. Keep every description on the variable's own line.
#
# References ${{...}} and secret() functions are typed literally. An empty
# value means the deployer fills it in from their own account.
#
# DATABASE_URL_BUILD is gone. The build runs its own throwaway database inside
# the image, so nothing here points at a public hostname and the template now
# passes Railway's private networking guideline. Delete the variable from the
# composer, and MySQL.MYSQL_PUBLIC_URL with it.
#
# isOptional is a toggle in the composer, not something this file can set.
# Anything carrying a default is non-blocking and stays required. Of the twelve
# that ship empty, only the two Upstash Redis ones are load-bearing; the other
# ten should be marked optional, or the deploy form demands twelve values before
# anyone can click Deploy.
# ============================================================================

# ----------------------------------------------------------------------------
# AUTO-WIRED REFERENCES - do not edit. Railway resolves these per deployment.
# ----------------------------------------------------------------------------
DATABASE_URL=${{MySQL.MYSQL_URL}}  # Private MySQL connection string, used at runtime. Wired automatically.
PLANETSCALE_DATABASE_URL=http://root:${{MySQL.MYSQLPASSWORD}}@${{PlanetScale Proxy.RAILWAY_PRIVATE_DOMAIN}}:3900/${{MySQL.MYSQLDATABASE}}  # Private address of the PlanetScale-compatible proxy that Dub's serverless driver queries. Wired automatically.
NEXT_PUBLIC_APP_DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}  # Hostname the dashboard is served on. Change it after adding your own domain to this service.
NEXTAUTH_URL=https://${{NEXT_PUBLIC_APP_DOMAIN}}  # Base URL NextAuth builds its callbacks from. Follows NEXT_PUBLIC_APP_DOMAIN.

# ----------------------------------------------------------------------------
# GENERATED SECRETS - Railway generates a fresh value per deployment.
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET=${{ secret(32) }}  # Signing key for session cookies. Generated for you.
CRON_SECRET=${{ secret(32) }}  # Shared secret authenticating calls to Dub's /api/cron endpoints. Generated for you.
ENCRYPTION_KEY=${{ secret(32, "base64") }}  # Key encrypting stored integration tokens. Must base64-decode to exactly 32 bytes.

# ----------------------------------------------------------------------------
# REQUIRED, EMPTY - keep these required. lib/middleware/link.ts awaits
# linkCache.get() unguarded on every redirect, so with Redis unset the Upstash
# client throws and every short link returns a 500.
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=  # Upstash Redis REST URL, from your database's REST API section at console.upstash.com. Caches links on the redirect path.
UPSTASH_REDIS_REST_TOKEN=  # Upstash Redis REST token, from the same REST API section.

# ----------------------------------------------------------------------------
# DEFAULTED - leave these required. A value is already present, so the deploy
# form does not block on them.
# ----------------------------------------------------------------------------
QSTASH_URL=https://qstash.upstash.io  # Upstash QStash endpoint. Change only if Upstash gives you a different region host.
TINYBIRD_API_URL=https://api.tinybird.co  # Tinybird region host for your workspace.

# ----------------------------------------------------------------------------
# OPTIONAL - mark these ten optional in the composer. Each call site runs inside
# waitUntil() with its errors swallowed, so an empty value costs the feature and
# nothing else.
# ----------------------------------------------------------------------------
QSTASH_TOKEN=  # Upstash QStash token, from the QStash page at console.upstash.com. Background jobs do not run without it.
QSTASH_CURRENT_SIGNING_KEY=  # QStash current signing key, which verifies incoming job callbacks.
QSTASH_NEXT_SIGNING_KEY=  # QStash next signing key, used while rotating the signing key.
TINYBIRD_API_KEY=  # Tinybird workspace admin token. Click analytics records nothing without it.
STORAGE_ENDPOINT=  # S3-compatible endpoint, for example https://<account-id>.r2.cloudflarestorage.com.
STORAGE_ACCESS_KEY_ID=  # Access key ID for the object storage buckets.
STORAGE_SECRET_ACCESS_KEY=  # Secret access key for the object storage buckets.
STORAGE_PUBLIC_BUCKET=  # Name of the publicly readable bucket, holding logos and social cards.
STORAGE_PRIVATE_BUCKET=  # Name of the private bucket.
STORAGE_BASE_URL=  # Public URL the public bucket is served on, for example https://pub-xxxx.r2.dev.

# Already optional, and they stay that way: a login method is mandatory but
# which one is a three-way choice, so no single variable can carry it.
GITHUB_CLIENT_ID=  # GitHub OAuth app client ID. Its callback URL is https://<your-domain>/api/auth/callback/github, so create the app after the first deploy.
GITHUB_CLIENT_SECRET=  # GitHub OAuth app client secret. Use GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, or RESEND_API_KEY, for the other login methods.

# ----------------------------------------------------------------------------
# BUILD-ONLY PLACEHOLDERS - keep the dummy values. Import-time SDK clients
# throw on an empty value while next build collects page data.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_dummy_for_build_only  # Placeholder so the Stripe client loads at build. Replace it only to enable billing.
STRIPE_APP_SECRET_KEY=sk_test_dummy_for_build_only  # Placeholder for the Stripe app client. Replace it only to enable billing.
STRIPE_APP_SECRET_KEY_TEST=sk_test_dummy_for_build_only  # Placeholder for the Stripe app's test mode.
STRIPE_APP_SECRET_KEY_SANDBOX=sk_test_dummy_for_build_only  # Placeholder for the Stripe app's sandbox mode.
UPSTASH_VECTOR_REST_URL=https://dummy-vector.upstash.io  # Placeholder so the Upstash Vector client loads at build. Replace it only to enable Dub's AI features.
UPSTASH_VECTOR_REST_TOKEN=dummy_build_only_token  # Placeholder token for Upstash Vector.

# ----------------------------------------------------------------------------
# NOT NEEDED: UNSUBSCRIBE_TOKEN_SECRET falls back to NEXTAUTH_SECRET, and the
# Vercel-only variables (VERCEL_*, TEAM_ID_VERCEL) do not apply on Railway.
# ----------------------------------------------------------------------------
