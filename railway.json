{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter web prisma:push && NODE_OPTIONS=--max-old-space-size=8192 pnpm build"
  },
  "deploy": {
    "startCommand": "pnpm --filter web start",
    "preDeployCommand": "pnpm --filter web prisma:push",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
